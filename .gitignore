# Local build and IDE output
test.cpp
build/
build-*/
release/
debug/
*.trace/
*.trace
.vscode/
.DS_Store
.metals/

# Downloaded source data and generated trajectory outputs
taxi_log_2008_by_id/
.cache/
/data/

# Python and notebook caches
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Generated benchmark output (tracked historical result snapshots remain tracked)
results/*.csv
results/*.png

# Generated report artifacts (tracked report sources and snapshots remain tracked)
/report/

# Per-intersection-pair dumps produced by `simplify --dump-intersect <id>`.
# These are intermediate artifacts for the test_convex_intersect benchmark
# and can be very large (case 10's dump is 270 MB).
data/**/*

# Trace JSON produced by `simplify --web-server` for the local web visualizer.
# These can be tens to hundreds of MB and are meant to be generated on demand.
web/*.trace.json
web/trace*.json
web/sample_trace.json

# CMake in-source build pollution
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
cmake.check_cache
CMakeConfigureLog.yaml
CMakeDirectoryInformation.cmake
CMakeRuleHashes.txt
CMakeScratch/
CMakeUserPresets.json
CTestTestfile.cmake
Makefile
compile_commands.json
libCGAL_*.a
.qt/

# AUTOGEN(BUILD) output
*_autogen/
*_autogen_timestamp_deps.dir/

# Resources generated from .qrc files
qrc_*.cpp
ui_*.h

# Top-level build directory symlinks (mirrored from release/ or build/)
